# 应用
APP_NAME=项目zz · 经营归因分析系统
APP_ENV=local
DEBUG=true
SECRET_KEY=change-me-in-real-env
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# 数据库（SQLite：数仓与业务表分成两个文件，见 docs/04-决策记录.md D-22）
# 数仓 dw.db 由沙箱以 file:...?mode=ro&immutable=1 打开，因此服务与沙箱都写不进它
DATA_DIR=.data
WAREHOUSE_DB_PATH=.data/dw.db
APP_DB_PATH=.data/app.db
DATABASE_URL=sqlite+pysqlite:///./.data/app.db

# 大模型（云端 DeepSeek；只用于假设生成、SQL 草案与报告写作，不参与数值计算）
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# 数据沙箱（受限子进程：无网络、只读打开、资源配额）
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MAX_ROWS=200000
SANDBOX_MEMORY_MB=768
SANDBOX_CPU_SECONDS=15
SANDBOX_ALLOW_PYTHON=true
SANDBOX_TMP_DIR=.data/sandbox

# 分解与守恒
ATTR_CONSERVATION_TOLERANCE=1e-9
ATTR_DEFAULT_DIMENSIONS=channel,category,region,segment
ATTR_MAX_HYPOTHESES=5
ATTR_MIN_CONFIDENCE=0.6
# 统计检验与置信度（P4）
ATTR_EFFECT_SMALL=0.2
ATTR_EFFECT_LARGE=0.8
ATTR_REQUIRED_COVERAGE_DAYS=21
# 观察窗口 42 天：切片内 vs 切片外共 84 个观测，满足"样本量 ≥60"的充分性要求
ATTR_OBSERVATION_DAYS=42
ATTR_PERMUTATIONS=10000
ATTR_EVENT_WINDOW_DAYS=3
# 切片贡献占比低于该值时不允许称为"主因"（需求说明书 §5.11）
ATTR_MIN_CONTRIBUTION_SHARE=0.05

# 合成数仓
WAREHOUSE_SEED=20260915
WAREHOUSE_DAYS=546
WAREHOUSE_START_DAY=2025-01-01

# 导出
EXPORT_DIR=.data/exports
VITE_API_BASE=http://127.0.0.1:8001
