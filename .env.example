# 应用
APP_NAME=项目zz · 经营归因分析系统
APP_ENV=local
DEBUG=true
SECRET_KEY=change-me-in-real-env
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# 数据库（合成数仓与业务表同一个实例、不同 schema）
DATABASE_URL=postgresql+psycopg://attr:attr@127.0.0.1:5432/attr
POSTGRES_USER=attr
POSTGRES_PASSWORD=attr
POSTGRES_DB=attr

# 大模型（云端 DeepSeek；只用于假设生成、SQL 草案与报告写作，不参与数值计算）
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# 数据沙箱（受限子进程：无网络、只读角色、资源配额）
SANDBOX_ENABLED=true
SANDBOX_DB_ROLE=attr_ro
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MAX_ROWS=200000
SANDBOX_MEMORY_MB=768
SANDBOX_CPU_SECONDS=15
SANDBOX_ALLOW_PYTHON=true
SANDBOX_TMP_DIR=.data/sandbox

# 分解与守恒
ATTR_CONSERVATION_TOLERANCE=1e-9
ATTR_DEFAULT_DIMENSIONS=channel,category,region,segment
ATTR_MAX_HYPOTHESES=5
ATTR_MIN_CONFIDENCE=0.6

# 合成数仓
WAREHOUSE_SEED=20260915
WAREHOUSE_DAYS=540
WAREHOUSE_DIM_CHANNELS=8
WAREHOUSE_DIM_CATEGORIES=12
WAREHOUSE_DIM_REGIONS=7
WAREHOUSE_DIM_SEGMENTS=5

# 导出
EXPORT_DIR=.data/exports
VITE_API_BASE=http://127.0.0.1:8001
